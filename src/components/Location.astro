---
import { business } from '../data/business';
import Icon from './Icon.astro';
import ContactButton from './ContactButton.astro';
---
<section class="section light" id="localizacao"><div class="container location-grid"><div class="location-copy"><span class="eyebrow">Perto de você</span><h2>Seu próximo passo?<br />Passar na Kacell.</h2><p>Estamos na Vila Hortência, em Sorocaba.<br />Venha conversar sobre o seu aparelho.</p><address><Icon name="map-pin" size={24}/><span><strong>{business.address}</strong><br />{business.neighborhood}, {business.city} - {business.state}<br />CEP {business.postalCode}</span></address><p class="hours"><Icon name="clock" size={20}/>{business.hours || 'Consulte nossos horários pelo WhatsApp.'}</p><div class="button-row"><a class="button button-dark" href={business.maps} target="_blank" rel="noopener noreferrer" data-event="directions_click" data-position="localizacao">Como chegar <Icon name="arrow-up-right" size={18}/></a><ContactButton label="WhatsApp" position="localizacao" secondary /></div><p class="accessories">Também temos acessórios para seu aparelho.<br />Consulte a disponibilidade.</p></div><div class="location-visual">{business.facade && <img class="facade" src={business.facade.src} alt={business.facade.alt} width={business.facade.width} height={business.facade.height} loading="lazy"/>}<div class="map-panel"><iframe title="Localização da Kacell na R. Cel. Nogueira Padilha, 1179, Sorocaba" src="https://www.google.com/maps?q=Kacell,+R.+Cel.+Nogueira+Padilha,+1179,+Sorocaba,+SP&output=embed" width="600" height="520" loading="eager" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div><a href={business.maps} target="_blank" rel="noopener noreferrer" class="text-link map-external" data-event="directions_click" data-position="mapa">Abrir no Google Maps <Icon name="arrow-up-right" size={16}/></a></div></div></section>
