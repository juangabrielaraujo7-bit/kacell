---
import Icon from './Icon.astro';
interface Props { items: {q: string; a: string}[] }
const { items } = Astro.props;
---
<div class="faq-list">{items.map(({q,a}) => <details class="faq-item"><summary>{q}<Icon name="plus" size={20} /></summary><div class="faq-answer"><p>{a}</p></div></details>)}</div>
