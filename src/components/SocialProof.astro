---
import { results, reviews, business } from '../data/business';
import Icon from './Icon.astro';
---
<section id="antes-e-depois" class="section dark">
  <div class="container">
    <div class="section-heading"><h2>Antes e depois.<br /><span class="muted">O cuidado aparece.</span></h2><p>Resultados reais de reparos realizados na Kacell.<br />O aparelho reparado e a peça danificada, lado a lado.</p></div>
    <div class="results-grid">{results.map((result,i)=><figure class="result-card">
      <button class="gallery-trigger" data-gallery-src={result.src} data-gallery-alt={result.alt} data-gallery-caption={result.caption} aria-label={`Ampliar resultado ${i+1}: ${result.caption}`}>
        <img src={result.card} srcset={`${result.thumbnail} 440w, ${result.card} ${result.width}w`} sizes="(max-width: 767px) 90vw, 30vw" alt={result.alt} width={result.width} height={result.height} loading="lazy" decoding="async"/>
      </button>
      <figcaption><div class="result-title"><h3>{result.caption}</h3><Icon name="zoom-in" size={20}/></div><div class="result-legend"><span><strong>Depois</strong>Aparelho à esquerda</span><span><strong>Antes</strong>Peça à direita</span></div></figcaption>
    </figure>)}</div>
  </div>
  <dialog id="gallery-dialog" aria-label="Resultado de reparo ampliado"><button class="dialog-close" aria-label="Fechar imagem"><Icon name="x"/></button><div class="gallery-image"></div><p class="gallery-caption"></p></dialog>
</section>
<section id="avaliacoes" class="section light">
  <div class="container" data-carousel>
    <div class="section-heading"><span class="eyebrow">Avaliações do Google</span><h2>Quem trouxe o aparelho<br />conta a experiência.</h2><a class="text-link" href={business.maps} target="_blank" rel="noopener noreferrer">Ver avaliações no Google <Icon name="arrow-up-right" size={18}/></a></div>
    <div class="review-track" role="region" aria-label="Três avaliações de clientes no Google" tabindex="0">{reviews.map(review=><figure class="review-card">
      <div class="review-top"><p class="review-rating" role="img" aria-label={`${review.rating} de 5 estrelas`}>{Array.from({length:review.rating},()=> <Icon name="star-filled" size={18}/>)}</p><span class="review-source"><Icon name="brand-google" size={19}/>Google</span></div>
      <blockquote>{review.excerpt || review.text}</blockquote>
      {review.excerpt && <p class="review-excerpt">Trecho da avaliação</p>}
      <figcaption><strong>{review.author}</strong><span>{review.date}</span></figcaption>
    </figure>)}</div>
    <div class="carousel-controls"><span aria-live="polite" data-carousel-status/><button data-direction="-1" aria-label="Avaliação anterior"><Icon name="arrow-left"/></button><button data-direction="1" aria-label="Próxima avaliação"><Icon name="arrow-right"/></button></div>
    <p class="review-dates-note">Datas relativas ao registro das avaliações em outubro de 2026.</p>
  </div>
</section>
