---
import { results, reviews, business } from '../data/business';
import Icon from './Icon.astro';
---
{results.length > 0 && <section id="antes-e-depois" class="section dark"><div class="container"><div class="section-heading"><h2>O cuidado aparece no resultado.</h2><p>Antes e depois de serviços realizados na Kacell.</p></div><div class="results-grid">{results.map(result=><figure><button class="gallery-trigger" data-gallery-src={result.src} data-gallery-alt={result.alt} aria-label={`Ampliar: ${result.alt}`}><img src={result.src} alt={result.alt} width={result.width} height={result.height} loading="lazy"/></button><figcaption>{result.caption}</figcaption></figure>)}</div></div><dialog id="gallery-dialog"><button class="dialog-close" aria-label="Fechar imagem"><Icon name="x"/></button><img alt="" /></dialog></section>}
{reviews.length > 0 && <section id="avaliacoes" class="section light"><div class="container" data-carousel><div class="section-heading"><h2>Quem conhece, conta.</h2><a class="text-link" href={business.maps} target="_blank" rel="noopener noreferrer">Ver avaliações no Google <Icon name="arrow-up-right" size={18}/></a></div><div class="review-track" role="region" aria-label="Avaliações de clientes" tabindex="0">{reviews.map(review=><figure class="review-card"><p class="review-rating" aria-label={`${review.rating} de 5 estrelas`}>{Array.from({length:review.rating},()=> <Icon name="star-filled" size={18}/>)}</p><blockquote>{review.text}</blockquote><figcaption>{review.author}<span>{review.date}</span></figcaption></figure>)}</div><div class="carousel-controls"><span aria-live="polite" data-carousel-status/><button data-direction="-1" aria-label="Avaliação anterior"><Icon name="arrow-left"/></button><button data-direction="1" aria-label="Próxima avaliação"><Icon name="arrow-right"/></button></div></div></section>}
